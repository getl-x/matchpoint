# Prefer a specific version for predictable updates.
MATCHPOINT_IMAGE=getl/matchpoint:1.1.2
MATCHPOINT_BIND=127.0.0.1
MATCHPOINT_PORT=4177
MATCHPOINT_ARCHIVE_SYNC=true
# Optional VAPID contact: your public HTTPS website or mailto: contact.
MATCHPOINT_PUSH_SUBJECT=https://github.com/getl-x/matchpoint
# Optional compose.https.yml; this domain must point to your server.
MATCHPOINT_DOMAIN=esports.example.com
